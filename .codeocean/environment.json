{
	"version": 1,
	"base_image": "codeocean/mambaforge3:23.1.0-4-python3.10.12-ubuntu22.04",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "build-essential",
					"version": "12.9ubuntu3"
				}
			],
			"install_software_properties_common": true
		},
		"pip3": {
			"packages": [
				{
					"name": "altair",
					"version": "6.1.0"
				},
				{
					"name": "hdmf-zarr",
					"version": "0.12.0"
				},
				{
					"name": "lazynwb",
					"version": "1.0.0.dev5"
				},
				{
					"name": "matplotlib",
					"version": "3.10.9"
				},
				{
					"name": "pynwb",
					"version": "3.1.3"
				},
				{
					"name": "seaborn",
					"version": "0.13.2"
				},
				{
					"name": "vl-convert-python",
					"version": "1.9.0.post1"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	}
}